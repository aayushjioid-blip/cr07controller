<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Gamepad Canvas Surface -->
    <com.controller.cricket07.ui.ControllerCanvasView
        android:id="@+id/controller_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Normal Gameplay Top Bar -->
    <RelativeLayout
        android:id="@+id/top_bar_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Mode / Preset Switcher Button -->
        <TextView
            android:id="@+id/btn_select_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="🎮 Mode: Cricket 07 ▼"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Bluetooth Connection Status Badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="Tap to Connect"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <!-- Edit Layout Button -->
        <TextView
            android:id="@+id/btn_edit_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_cyan"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="✏️ Edit Layout"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Edit Mode Top Bar (Visible when editing) -->
    <RelativeLayout
        android:id="@+id/top_bar_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DD000000"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Reset Positions Button -->
        <TextView
            android:id="@+id/btn_reset_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_red"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="↺ Reset Defaults"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Instructions Banner -->
        <TextView
            android:id="@+id/tv_edit_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="✏️ Touch &amp; Drag any button or analog dial"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Save & Done Button -->
        <TextView
            android:id="@+id/btn_save_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_green"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:text="✓ Save &amp; Done"
            android:textColor="#69F0AE"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Gamepad Canvas Surface (Full Screen Multi-Touch) -->
    <com.controller.cricket07.ui.ControllerCanvasView
        android:id="@+id/controller_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Normal HUD Top Bar (Always in Front, High Elevation) -->
    <RelativeLayout
        android:id="@+id/top_bar_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="25dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <!-- Mode / Controller vs Keyboard Switcher -->
        <LinearLayout
            android:id="@+id/btn_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_cyan"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_active_mode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 CONTROLLER (P2)"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_active_preset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cricket 07 Day Out ▼"
                android:textColor="#B0BEC5"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Center Connection & Device Detection Banner -->
        <LinearLayout
            android:id="@+id/btn_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="5dp"
            android:paddingEnd="16dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to Connect Bluetooth"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Detected: OnePlus 13R (Multiplayer P2)"
                android:textColor="#81C784"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Edit Layout Button -->
        <TextView
            android:id="@+id/btn_edit_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="✏️ Edit Layout"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Edit Mode Top Bar (Visible when in Edit Mode) -->
    <RelativeLayout
        android:id="@+id/top_bar_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EE000000"
        android:elevation="25dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Reset Defaults Button -->
        <TextView
            android:id="@+id/btn_reset_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_red"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="↺ Reset Defaults"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Instructions Banner -->
        <TextView
            android:id="@+id/tv_edit_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="✏️ Drag to move • Pinch in/out to resize"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Save & Done Button -->
        <TextView
            android:id="@+id/btn_save_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="💾 Save &amp; Done"
            android:textColor="#69F0AE"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

</FrameLayout>
